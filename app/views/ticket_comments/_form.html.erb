<%= form_with model: [ticket, comment], id: "new_ticket_comment", class: "flex gap-2 border-t border-stone-200 p-3" do |form| %>
  <%= form.text_field :body, required: true, maxlength: 2000, aria: { label: "Add workshop note" }, placeholder: "Record a floor update...", class: "h-10 min-w-0 flex-1 border border-stone-300 px-3 text-sm" %>
  <%= form.submit "Add note", class: "h-10 bg-emerald-900 px-4 text-sm font-semibold text-white" %>
<% end %>