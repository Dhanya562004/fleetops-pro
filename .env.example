# Local development example only. Never paste production secrets into this file.

RAILS_ENV=development
PORT=3000

# Local database/Redis values are supplied by docker-compose.yml.
DATABASE_URL=postgresql://fleetops:fleetops@localhost:5432/fleetops_pro_development
REDIS_URL=redis://localhost:6379/0

# Generate a local secret with `bundle exec rails secret`.
SECRET_KEY_BASE=
RAILS_MASTER_KEY=

# Enable only for the first deployment, then set false in the host dashboard.
SEED_ON_BOOT=false
SOLID_QUEUE_IN_PUMA=true
